# AI Provider Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# App Settings
LOG_LEVEL=INFO
MODEL_NAME=gpt-4o-mini  

# Task 2: internal assistant
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_TIMEOUT_SECONDS=15.0
ASSISTANT_MAX_RETRIES=3
ASSISTANT_RETRY_BASE_DELAY=1.0
ASSISTANT_TOTAL_DEADLINE=45.0
ASSISTANT_MAX_OUTPUT_TOKENS=600
ASSISTANT_MAX_TICKET_CHARS=1500
ASSISTANT_TOP_K=2
ASSISTANT_MIN_SCORE=1.0
ASSISTANT_KB_PATH=data/kb/articles.json
ASSISTANT_EVAL_PATH=data/eval_tickets.json